# Required. Signs the session cookie. Sign-in fails without it.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Required. Strava is how users sign in, so the app is unusable without these.
# Create a Strava API app at https://www.strava.com/settings/api
# Set the Authorization Callback Domain to your app's host (e.g. localhost)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Twilio (optional). Enables SMS workout alerts.
# US numbers also need A2P 10DLC or toll-free registration, or carriers drop
# the messages after Twilio accepts them (error 30034).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a number, or a Messaging Service. Registration attaches numbers to a
# Messaging Service, and sending through its SID keeps traffic tied to the
# registered campaign, so it takes precedence when both are set.
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Mapbox (optional). Draws run routes on a real map instead of a plain shape.
# Create a token at https://account.mapbox.com/access-tokens/
# Static Images API is free up to 50,000 requests a month. Without this the app
# still draws the route, just without streets underneath.
MAPBOX_TOKEN=

# Optional. Lets you tick /api/cron/alerts manually with a Bearer token.
# The GitHub Actions "Morning alerts" workflow authenticates with GitHub OIDC
# instead, so this is only needed for manual testing or non-GitHub schedulers.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# Postgres connection string (optional), used in production (e.g. Neon on Vercel).
# When unset, state is stored in a local SQLite file under ./data.
DATABASE_URL=

# --- Web push notifications (the default alert channel) ---
# Generate a pair with:  node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key is served to the browser, so it must use the NEXT_PUBLIC_ prefix.
# The private key signs pushes and must never reach the client.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address push services can reach you at if a subscription misbehaves.
VAPID_SUBJECT=mailto:you@example.com
