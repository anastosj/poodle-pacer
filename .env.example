# Create a Strava API app at https://www.strava.com/settings/api
# Set the Authorization Callback Domain to your app's host (e.g. localhost)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Twilio (optional) — enables SMS workout alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Postgres connection string (optional) — used in production (e.g. Neon on Vercel).
# When unset, state is stored in a local SQLite file under ./data.
DATABASE_URL=
